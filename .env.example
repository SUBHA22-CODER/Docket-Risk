# Copy to .env (git-ignored) and fill in before docker compose up.

# --- REQUIRED -----------------------------------------------------------
# Postgres credentials for the durable-store containers.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_USER=ring_sentinel
POSTGRES_DB=ring_sentinel

# Comma-separated API keys accepted by the scoring service (X-API-Key header).
# Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RING_SENTINEL_API_KEYS=

# --- OPTIONAL (defaults shown) ------------------------------------------
RING_SENTINEL_HIGH=0.85
RING_SENTINEL_MEDIUM=0.50
RING_SENTINEL_MODEL=models/ring_sentinel_xgb.json
RING_SENTINEL_SNAPSHOT=data/graph_state_snapshot.json
RING_SENTINEL_SNAPSHOT_INTERVAL=60
RING_SENTINEL_AUDIT_DB=data/decisions.db
RING_SENTINEL_MAX_NODES=2000000
RING_SENTINEL_MAX_CLUSTER=5000
RING_SENTINEL_PRUNE_DAYS=30
RING_SENTINEL_RATE_LIMIT=600
RING_SENTINEL_LOG_LEVEL=INFO
